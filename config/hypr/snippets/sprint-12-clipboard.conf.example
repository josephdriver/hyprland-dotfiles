# Sprint 12 clipboard snippet
# Purpose:
# - start cliphist watchers for regular and primary selections
# - bind clipboard history to SUPER + X

exec-once = wl-paste --type text --watch cliphist store
exec-once = wl-paste --primary --type text --watch cliphist store
bind = $mainMod, X, exec, $HOME/.local/share/hyprland-setup/scripts/clipboard-menu.sh
